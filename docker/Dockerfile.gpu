FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 python3-pip ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml .
COPY video_eval/ video_eval/
COPY config.yaml.example config.yaml

RUN pip install --no-cache-dir -e '.[all]' && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

ENTRYPOINT ["video-eval"]
CMD ["--help"]
